{ pkgs, ... }: {
  programs.waybar = {
    enable = true;
    settings = [{
      layer = "top";
      position = "top";
      modules-left = [ "niri/window" ];
      modules-center = [ "clock" ];
      modules-right = [ "cpu" "memory" "battery" "network" ];
      
      "clock" = { format = "{:%H:%M | %a %d}"; };
      "battery" = { states = { "warning" = 30; "critical" = 15; }; };
    }];
    style = ''
      window#waybar {
      background: rgba(26, 27, 38, 0.6);
      border-bottom: 2px solid rgba(122, 162, 247, 0.5);
      border-radius: 10px;
      margin: 5px;
    }
    #clock, #cpu, #memory {
      color: #7aa2f7;
      padding: 0 10px;
    }
    '';
  };
}
