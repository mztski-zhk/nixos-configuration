{ pkgs, ... }: 
let
  # A small helper script for the screenshot
  shot = pkgs.writeScriptBin "shot" ''
    ${pkgs.grim}/bin/grim -g "$(${pkgs.slurp}/bin/slurp)" - | ${pkgs.wl-clipboard}/bin/wl-copy
    ${pkgs.libnotify}/bin/notify-send "Screenshot" "Captured to clipboard" -i camera
  '';
in {
  home.packages = [ pkgs.grim pkgs.slurp shot ];
}
