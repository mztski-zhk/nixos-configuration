{ config, lib, pkgs, ... }: {
  # 1. Enable NVIDIA Drivers
  services.xserver.videoDrivers = [ "nvidia" ];

  hardware.nvidia = {
    modesetting.enable = true;
    powerManagement.enable = true; # Necessary for suspend/resume
    powerManagement.finegrained = true; # Turns off GPU when not in use
    open = true; # Use the NVIDIA Open Kernel Module (Recommended for 40-series)
    nvidiaSettings = true;
    
    # 2. Setup Prime (Hybrid Graphics)
    prime = {
      offload = {
        enable = true;
        enableOffloadCmd = true;
      };

      amdgpuBusId = "PCI:65:00.0";
      nvidiaBusId = "PCI:64:00.0";
    };
  };

  # 3. Asus Specific Tools
  services.asusd = {
    enable = true;
    enableUserService = true;
  };
  
  # Power management (replaces TLP for better compatibility with asusd)
  services.power-profiles-daemon.enable = true;
}
